# Variables para correr la aplicación con Docker (docker compose up --build).
# Copie este archivo como .env.docker y complete lo que necesite. .env.docker no se sube al repositorio.
# Todo es opcional: sin claves la aplicación abre igual, pero los agentes no pueden usar el modelo.

# --- Modelo (OpenCode Go) ---------------------------------------------------------------
# Sin esta clave la interfaz abre, pero el análisis con los agentes no funciona.
OPENCODE_API_KEY=
OPENCODE_PROVIDER_ID=opencode-go
OPENCODE_MODEL_ID=glm-5.3-flash
ANALISTA_TURN_TIMEOUT_SECONDS=180
ANALISTA_MCP_TRANSPORTE=memoria

# --- Base de datos ---------------------------------------------------------------------
# Vacía: SQLite dentro del volumen «datos» (se conserva al apagar el contenedor).
# Con la cadena de TiDB se comparten los datos con Render.
DATABASE_URL=

# --- Inicio de sesión -------------------------------------------------------------------
# Vacíos: modo local, sin usuarios y con todas las acciones permitidas.
ACCESO_USUARIO=
ACCESO_CLAVE=
# Firma de las sesiones: un valor al azar, distinto de ACCESO_CLAVE.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SESION_SECRETO=

# --- Conocimiento (Pinecone) ------------------------------------------------------------
# Vacía: se usa la copia local de respaldo.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=historias-usuario
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_DIMENSION=1024
PINECONE_METRIC=cosine
PINECONE_EMBEDDING_MODEL=multilingual-e5-large

# --- Asesor Técnico ---------------------------------------------------------------------
ASESOR_REPOSITORIO_URL=https://github.com/Yuvania/codigo-ejemplo-polizas.git
ASESOR_REPOSITORIO_RAMA=main

# --- Observabilidad (Langfuse) ----------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# --- Pruebas automatizadas (GitHub Actions) ---------------------------------------------
# Token fine-grained con «Actions: lectura y escritura» solo sobre el repositorio.
# Fuera de Render hay que decir de qué repositorio y rama (en Render se toman solos).
GITHUB_PRUEBAS_TOKEN=
GITHUB_PRUEBAS_REPOSITORIO=
GITHUB_PRUEBAS_RAMA=main
